# Aplicacao
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=troque-por-um-valor-longo-e-aleatorio
CORS_ORIGINS=http://localhost:5173

# Banco
DATABASE_URL=postgresql+psycopg://energydiag:energydiag@host.docker.internal:5432/energydiag

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/uploads
S3_ENDPOINT_URL=http://host.docker.internal:9000
S3_BUCKET=energydiag
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# LLM (nunca versionar chaves)
LLM_PROVIDER=
LLM_MODEL=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LLM_TIMEOUT_S=90
LLM_MONTHLY_BUDGET_BRL=

# Upload
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=12

# Autenticacao
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Seed de desenvolvimento
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
